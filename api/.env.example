# Local development defaults. For Lambda, set APP_RUNTIME=lambda and LLM_ENABLED=false.
APP_RUNTIME=local
DATABASE_URL=postgresql+psycopg://survey:survey@127.0.0.1:5432/survey
JWT_SECRET=change-me-to-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-nano-2025-08-07
